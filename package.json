{
  "name": "skillsync",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Sync AI agent skills across multiple tools from one canonical repo",
  "bin": { "skillsync": "./dist/cli.js" },
  "repository": "https://github.com/nadimtuhin/skillsync",
  "homepage": "https://github.com/nadimtuhin/skillsync",
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --outfile dist/cli.js --target bun",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "commander": "^12.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0",
    "@biomejs/biome": "^1.8.0",
    "typescript": "^5.5.0"
  }
}
