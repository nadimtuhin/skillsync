{
  "name": "@nadimtuhin/skillctl",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Sync AI agent skills across multiple tools from one canonical repo",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "skillctl": "./dist/cli.js"
  },
  "repository": "https://github.com/nadimtuhin/skillsync",
  "homepage": "https://github.com/nadimtuhin/skillsync",
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --outfile dist/cli.js --target bun",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^4.1.8",
    "@types/node": "^25.9.1",
    "@biomejs/biome": "^2.4.15",
    "typescript": "^6.0.3"
  }
}
